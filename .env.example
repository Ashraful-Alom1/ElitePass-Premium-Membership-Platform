# ============================================
# ElitePass Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is in .gitignore.
#
# For Vercel: add these in Project Settings → Environment Variables
# For Render: add these in Service → Environment tab
# ============================================

# Payment (server-side only — never expose secret keys in frontend JS)
# STRIPE_SECRET_KEY=sk_live_your_key_here
# STRIPE_PUBLISHABLE_KEY=pk_live_your_key_here

# Analytics (optional)
# GA_TRACKING_ID=G-XXXXXXXXXX
